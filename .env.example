# Phase 1 API settings. Do not put secrets in this file.
AI_SUPPORT_ENV=development
AI_SUPPORT_HOST=127.0.0.1
AI_SUPPORT_PORT=8000
AI_SUPPORT_LOG_LEVEL=INFO

# Registered router alias or explicit version. Use champion for normal serving.
AI_SUPPORT_ROUTER_MODEL_REFERENCE=champion

# Optional: suppress MLflow's development-time assistant hint in command output.
MLFLOW_DISABLE_AGENT_HINT=1

# Phase 3 persistent RAG index. Replace placeholders locally; do not commit credentials.
# AI_SUPPORT_DATABASE_URL=postgresql://ai_support:change-me@127.0.0.1:5432/ai_support

# Optional shared model cache outside the repository.
# HF_HOME=/path/to/huggingface-cache
